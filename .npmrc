# `@base-ui/react` lists `date-fns@^4` as an *optional* peer dependency, while this
# project pins `date-fns@^3`. The mismatch is harmless — the peer is optional and
# @base-ui/react works fine without v4 — but strict peer resolution makes `npm ci`
# refuse to install at all. Keep resolution lenient so installs work locally and on
# Vercel without pinning every contributor to an extra CLI flag.
#
# Remove this once `date-fns` is upgraded to v4 (used in 10 files; only format,
# parseISO, addDays, addMonths, subDays, startOfWeek, startOfMonth, startOfYear
# and formatDistanceToNow are needed, all of which exist in v4).
legacy-peer-deps=true
